# DEMO-ONLY image for Render: everything is preconfigured, so no environment variables are needed.
# Never use this for production (use backend/Dockerfile). See docs/demo-mode.md.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEMO_MODE=true \
    APP_ENV=staging \
    DATABASE_URL=sqlite+pysqlite:///./demo.db \

WORKDIR /app

COPY pyproject.toml ./
COPY app ./app

RUN pip install --no-cache-dir .

EXPOSE 8000
# No Alembic: the API creates its SQLite tables and the demo account itself at startup.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
